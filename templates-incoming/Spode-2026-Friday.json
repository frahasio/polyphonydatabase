    {
      "id": "b_yu07yj51h1mqp6biex",
      "type": "reading",
      "text": "O salutáris Hostia,<br>Quæ cæli pandis óstium:<br>Bella premunt hostília,<br>Da robur, fer auxílium.",
      "translation": "<div style=\"text-align: right;\"><p></p><div style=\"text-align:justify\"><div style=\"text-align: right;\"><span style=\"font-size: 0.875rem;\">O saving Victim,</span></div><div style=\"text-align: right;\"><span style=\"font-size: 0.875rem;\">Who expandest the door of heaven,</span></div><div style=\"text-align: right;\"><span style=\"font-size: 0.875rem;\">Hostile armies press,</span></div><div style=\"text-align: right;\"><span style=\"font-size: 0.875rem;\">Give strength; bear aid.</span></div></div><p></p></div>",
      "parallelLeftPct": 49.75,
      "parallelBorder": false,
      "parallelGapMm": 6,
