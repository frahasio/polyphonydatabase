      "text": "<p style=\"color:rgb(0, 0, 0);text-align:justify\"><span style=\"color:rgb(32, 33, 34)\">Ave María, grátia plena,<br></span><span style=\"color:rgb(32, 33, 34)\">Dóminus tecum.<br></span><span style=\"color:rgb(32, 33, 34)\">Benedícta tu in muliéribus,<br></span><span style=\"color:rgb(32, 33, 34)\">et benedíctus fructus ventris tui.</span></p>",
      "translation": "<div style=\"text-align:right\"><div style=\"text-align:right\"><span style=\"color:rgb(32, 33, 34)\">Hail Mary, full of grace,</span></div><span style=\"color:rgb(32, 33, 34)\"><div style=\"text-align:right\"><span>The Lord is with thee.</span></div></span><span style=\"color:rgb(32, 33, 34)\"><div style=\"text-align:right\"><span>Blessed art thou amongst women,</span></div></span><span style=\"color:rgb(32, 33, 34)\"><div style=\"text-align:right\"><span>And blessed is the fruit of thy womb</span></div></span></div>",
