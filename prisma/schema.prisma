// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Composer {
  id                Int                  @id @default(autoincrement())
  name              String?
  fromYear          Int?                 @map("from_year")
  toYear            Int?                 @map("to_year")
  fromYearAnnotation String?             @map("from_year_annotation")
  toYearAnnotation  String?             @map("to_year_annotation")
  birthplace1       String?             @map("birthplace_1")
  birthplace2       String?             @map("birthplace_2")
  deathplace1       String?             @map("deathplace_1")
  deathplace2       String?             @map("deathplace_2")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  compositions      ComposerComposition[]
  searchVector      Unsupported("tsvector")? @map("search_vector")

  @@map("composers")
}

model ComposerComposition {
  id            Int         @id @default(autoincrement())
  composer      Composer    @relation(fields: [composerId], references: [id])
  composerId    Int         @map("composer_id")
  composition   Composition @relation(fields: [compositionId], references: [id])
  compositionId Int         @map("composition_id")

  @@map("composer_compositions")
}

model Composition {
  id                Int                  @id @default(autoincrement())
  numberOfVoices    Int?                @map("number_of_voices")
  groupId           Int?                @map("group_id")
  titleId           Int?                @map("title_id")
  title             String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  compositionTypeId Int?                @map("composition_type_id")
  tone              Int?
  evenOdd           Int?                @map("even_odd")
  composerIdList    Int[]               @map("composer_id_list")
  composers         ComposerComposition[]

  @@map("compositions")
}

model Editor {
  id                Int                  @id @default(autoincrement())
  name              String?
  dateOfBirth       DateTime?            @map("date_of_birth")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  searchVector      Unsupported("tsvector")? @map("search_vector")

  @@map("editors")
}

model Scribe {
  id                Int                  @id @default(autoincrement())
  name              String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  searchVector      Unsupported("tsvector")? @map("search_vector")
  scribeSources     ScribeSource[]

  @@map("scribes")
}

model Publisher {
  id                Int                  @id @default(autoincrement())
  name              String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  searchVector      Unsupported("tsvector")? @map("search_vector")
  publisherSources  PublisherSource[]

  @@map("publishers")
}

model Performer {
  id                Int                  @id @default(autoincrement())
  name              String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  searchVector      Unsupported("tsvector")? @map("search_vector")

  @@map("performers")
}

model Source {
  id                Int                  @id @default(autoincrement())
  code              String               @unique
  title             String?
  type              String?
  format            String?
  town              String?
  rismLink          String?             @map("rism_link")
  catalogued        Boolean             @default(false)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  fromYear          Int?                @map("from_year")
  toYear            Int?                @map("to_year")
  fromYearAnnotation String?            @map("from_year_annotation")
  toYearAnnotation  String?             @map("to_year_annotation")
  dates             String?
  searchVector      Unsupported("tsvector")? @map("search_vector")
  images            SourceImage[]
  inclusions        Inclusion[]
  publisherSources  PublisherSource[]
  scribeSources     ScribeSource[]

  @@map("sources")
}

model SourceImage {
  id          Int      @id @default(autoincrement())
  url         String
  label       String?
  sourceId    Int      @map("source_id")
  source      Source   @relation(fields: [sourceId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("source_images")
}

model Inclusion {
  id        Int      @id @default(autoincrement())
  sourceId  Int?     @map("source_id")
  notes     String?
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  position  Int?
  compositionId Int? @map("composition_id")
  missingClefIds Int[] @default([]) @map("missing_clef_ids")
  incompleteClefIds Int[] @default([]) @map("incomplete_clef_ids")
  clefCombinationId Int? @map("clef_combination_id")
  transitionsTo Json? @map("transitions_to")
  bothClefIds Int[] @default([]) @map("both_clef_ids")

  // Relations
  source    Source?  @relation(fields: [sourceId], references: [id])

  @@map("inclusions")
}

model PublisherSource {
  publisher   Publisher @relation(fields: [publisherId], references: [id])
  publisherId Int
  source      Source    @relation(fields: [sourceId], references: [id])
  sourceId    Int

  @@id([publisherId, sourceId])
  @@map("publishers_sources")
}

model ScribeSource {
  scribe   Scribe @relation(fields: [scribeId], references: [id])
  scribeId Int
  source   Source @relation(fields: [sourceId], references: [id])
  sourceId Int

  @@id([scribeId, sourceId])
  @@map("scribes_sources")
} 